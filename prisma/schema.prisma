// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Student {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  enrollmentDate      DateTime
  gradeLevel          Int
  socioEconomicStatus String             // e.g., 'Low', 'Middle', 'High'
  riskScore           Float?             // AI calculated risk score
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  academicRecords     AcademicRecord[]
  attendanceRecords   Attendance[]
  interventions       Intervention[]
}

model AcademicRecord {
  id            String   @id @default(cuid())
  studentId     String
  term          String   // e.g., 'Fall 2023'
  gpa           Float
  creditsEarned Int
  mathGrade     Float?
  englishGrade  Float?
  
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String   @id @default(cuid())
  studentId    String
  term         String
  totalDays    Int
  daysAttended Int
  daysAbsent   Int

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Intervention {
  id          String   @id @default(cuid())
  studentId   String
  date        DateTime @default(now())
  type        String   // 'counseling', 'tutoring', 'financial_aid'
  notes       String?
  status      String   @default("recommended") // 'recommended', 'in_progress', 'completed'

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
